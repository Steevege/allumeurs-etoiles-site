---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import mjcScene from '../assets/mjc/scene-paysage.jpg';

// Récupérer tous les spectacles actifs
const spectacles = (await getCollection('spectacles'))
  .filter(s => s.data.active)
  .sort((a, b) => a.data.order - b.data.order);

// Visuel de la création en cours (cadrage paysage, sans la typographie de l'affiche)
const mjcImage = await getImage({
  src: mjcScene,
  format: 'webp',
  widths: [420, 640, 900],
  sizes: '(min-width: 900px) 40vw, 100vw',
  quality: 80,
});
---

<Layout 
  title="Nos Spectacles" 
  description="Découvrez notre répertoire de spectacles musicaux et théâtraux : Il était 2 foi(s), Vices & Versa, Côte à côte et bien d'autres créations."
>
  <!-- En-tête de page -->
  <section class="page-header">
    <div class="container">
      <h1>Nos Spectacles</h1>
      <p class="page-subtitle">
        Découvrez notre répertoire de spectacles musicaux et théâtraux pour émouvoir et faire réfléchir
      </p>
    </div>
  </section>

  <!-- Liste des spectacles -->
  <section class="spectacles-list">
    <div class="container">
      <!-- Création en cours : renvoie vers la page dédiée /mjc -->
      <article class="mjc-card">
        <a href="/mjc" class="mjc-card-media" tabindex="-1" aria-hidden="true">
          <img
            src={mjcImage.src}
            srcset={mjcImage.srcSet.attribute}
            sizes="(min-width: 900px) 40vw, 100vw"
            alt=""
            width="1600"
            height="1066"
            loading="lazy"
            decoding="async"
          />
        </a>
        <div class="mjc-card-body">
          <p class="mjc-card-status">
            <span class="mjc-card-dot" aria-hidden="true"></span>
            En création
          </p>
          <h2 class="mjc-card-title">
            <span>Monsieur</span>
            Jésus-Christ
          </h2>
          <p class="mjc-card-baseline">Le livre monte sur scène</p>
          <p class="mjc-card-text">
            Un seul-en-scène de Steeve Gernez, mis en scène par Jacques Montembault, d'après le livre
            de Patrick Richard. Les répétitions ont commencé : suivez les étapes de la création.
          </p>
          <a href="/mjc" class="mjc-card-btn">Découvrir le projet →</a>
        </div>
      </article>

      <div class="spectacles-grid">
        {spectacles.map((spectacle) => (
          <article class="spectacle-card">
            <div class="card-image">
              <img
                src={spectacle.data.image}
                alt={spectacle.data.title}
                loading="lazy"
                width="600"
                height="400"
              />
            </div>
            <div class="card-content">
              <h2>{spectacle.data.title}</h2>
              {spectacle.data.subtitle && (
                <p class="card-subtitle">{spectacle.data.subtitle}</p>
              )}
              <p class="card-description">{spectacle.data.description}</p>
              
              <div class="card-meta">
                <span class="meta-item">
                  <strong><Icon name="clock" size={16} /> Durée :</strong> {spectacle.data.duration}
                </span>
                <span class="meta-item">
                  <strong><Icon name="users" size={16} /> Public :</strong> {spectacle.data.audience}
                </span>
              </div>

              <a href={`/spectacles/${spectacle.slug}`} class="btn btn-primary">
                En savoir plus →
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Réservation -->
  <section class="cta-section">
    <div class="container">
      <h2>Envie d'accueillir un de nos spectacles ?</h2>
      <p>Contactez-nous pour organiser une représentation dans votre ville, théâtre, école ou festival.</p>
      <a href="/contact" class="btn btn-primary btn-large">Demande de réservation</a>
    </div>
  </section>
</Layout>

<style>
  .page-header {
    background: linear-gradient(135deg, rgba(35, 61, 76, 0.95) 0%, rgba(0, 0, 0, 0.85) 100%);
    color: white;
    padding: 5rem 0 4rem;
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .page-header::before {
    content: '';
    position: absolute;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(253, 128, 46, 0.15) 0%, transparent 70%);
    border-radius: 50%;
    top: -250px;
    right: -100px;
    animation: cosmic-float 20s ease-in-out infinite;
  }

  @keyframes cosmic-float {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(30px, -30px) scale(1.1); }
  }

  .page-header h1 {
    color: white;
    font-size: clamp(2.5rem, 5vw, 4rem);
    margin-bottom: 1rem;
    position: relative;
  }

  .page-subtitle {
    font-size: 1.35rem;
    opacity: 0.95;
    max-width: 700px;
    margin: 0 auto;
    position: relative;
  }

  .spectacles-list {
    padding: var(--spacing-xl) 0;
  }

  .spectacles-grid {
    display: grid;
    gap: 4rem;
  }

  .spectacle-card {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: 3rem;
    background: white;
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    border: 1px solid rgba(35, 61, 76, 0.08);
    position: relative;
  }

  .spectacle-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 4px;
    background: linear-gradient(90deg, var(--color-secondary), var(--color-primary));
  }

  .spectacle-card:hover {
    transform: translateY(-8px);
    box-shadow: var(--shadow-lg);
  }

  .spectacle-card:nth-child(even) {
    grid-template-columns: 1.3fr 1fr;
    direction: rtl;
  }

  .spectacle-card:nth-child(even) > * {
    direction: ltr;
  }

  .card-image {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: linear-gradient(135deg, var(--color-primary), #1a3340);
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .spectacle-card:hover .card-image img {
    transform: scale(1.08);
  }

  .card-content {
    padding: 3rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .card-content h2 {
    color: var(--color-primary);
    margin-bottom: 0.75rem;
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-family: var(--font-heading);
    font-style: italic;
  }

  .card-subtitle {
    font-style: italic;
    color: #6B7280;
    margin-bottom: 1.5rem;
    font-size: 1.15rem;
  }

  .card-description {
    line-height: 1.8;
    margin-bottom: 2rem;
    color: #374151;
  }

  .card-meta {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 2rem;
    padding: 1.5rem;
    background: linear-gradient(135deg, var(--color-light-bg) 0%, white 100%);
    border-radius: var(--radius-md);
    border: 1px solid rgba(35, 61, 76, 0.08);
  }

  .meta-item {
    font-size: 1rem;
    color: #374151;
  }

  .meta-item strong {
    color: var(--color-primary);
    font-weight: 600;
  }

  .cta-section {
    background: linear-gradient(135deg, var(--color-primary) 0%, #1a3340 100%);
    color: white;
    padding: var(--spacing-xl) 0;
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .cta-section::before {
    content: '';
    position: absolute;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(253, 128, 46, 0.2) 0%, transparent 70%);
    border-radius: 50%;
    bottom: -250px;
    right: -100px;
    animation: cosmic-float 20s ease-in-out infinite reverse;
  }

  .cta-section h2 {
    color: white;
    font-size: clamp(2.5rem, 4vw, 3.5rem);
    margin-bottom: 1.5rem;
    position: relative;
  }

  .cta-section p {
    font-size: 1.25rem;
    margin-bottom: 2.5rem;
    opacity: 0.95;
    position: relative;
  }

  .btn-large {
    padding: 1.25rem 2.5rem;
    font-size: 1.1rem;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .page-header {
      padding: 3rem 0 2rem;
    }

    .spectacles-grid {
      gap: 2.5rem;
    }

    .spectacle-card,
    .spectacle-card:nth-child(even) {
      grid-template-columns: 1fr;
      direction: ltr;
    }

    .card-content {
      padding: 2rem;
    }
  }

  /* ============================================================
     Carte « En création » (Monsieur Jésus-Christ)
     Placée hors de la grille pour ne pas décaler l'alternance
     gauche/droite des fiches existantes. Palette de l'affiche.
     ============================================================ */
  .mjc-card {
    display: grid;
    gap: 0;
    margin-bottom: 4rem;
    background-color: #f7f0e2;
    border: 1px solid rgba(36, 49, 58, 0.12);
    border-top: 4px solid #9e4e32;
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .mjc-card-media {
    display: block;
    min-height: 220px;
  }

  .mjc-card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    aspect-ratio: 3 / 2;
  }

  .mjc-card-body {
    padding: clamp(1.75rem, 4vw, 3rem);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
  }

  .mjc-card-status {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0 0 1.25rem;
    padding: 0.4rem 1rem;
    border: 1px solid rgba(158, 78, 50, 0.4);
    border-radius: 999px;
    background-color: rgba(158, 78, 50, 0.07);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #9e4e32;
  }

  .mjc-card-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background-color: #9e4e32;
  }

  .mjc-card-title {
    margin: 0 0 0.75rem;
    color: #24313a;
    font-family: var(--font-heading);
    font-style: normal;
    font-weight: 900;
    font-size: clamp(1.9rem, 4vw, 3rem);
    line-height: 0.95;
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }

  .mjc-card-title span {
    display: block;
    font-size: 0.45em;
    font-weight: 700;
    letter-spacing: 0.03em;
    margin-bottom: 0.15em;
  }

  .mjc-card-baseline {
    margin: 0 0 1.25rem;
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #9e4e32;
  }

  .mjc-card-text {
    margin: 0 0 2rem;
    font-size: 1.05rem;
    line-height: 1.7;
    color: #4e5b63;
  }

  .mjc-card-btn {
    display: inline-block;
    padding: 0.9rem 2rem;
    background-color: #9e4e32;
    color: #fff;
    border-radius: 2px;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition: background-color 0.25s ease, transform 0.25s ease;
  }

  .mjc-card-btn:hover {
    background-color: #b85c39;
    color: #fff;
    transform: translateY(-2px);
  }

  .mjc-card-btn:focus-visible {
    outline: 3px solid #24313a;
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .mjc-card-btn:hover {
      transform: none;
    }
  }

  @media (min-width: 900px) {
    .mjc-card {
      grid-template-columns: 1fr 1.3fr;
    }

    .mjc-card-media img {
      aspect-ratio: auto;
    }
  }
</style>
