---
import Layout from '../layouts/Layout.astro';
import { getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import scenePortrait from '../assets/mjc/clermont-appui-table-20261020.png';
import scenePain from '../assets/mjc/clermont-pain-20261020.png';
import sceneBrasOuverts from '../assets/mjc/clermont-bras-ouverts-20261020.png';

const fundraiserUrl = 'https://www.helloasso.com/associations/allumeurs-d-etoiles/collectes/soutenez-la-creation-de-monsieur-jesus-christ';

// Actualités du projet : conserver les étapes dans l'ordre du récit.
const newsMjc = (await getCollection('news'))
  .filter((n) => n.data.project === 'mjc')
  .map((n) => ({ slug: n.slug, title: n.data.title, date: n.data.date, excerpt: n.data.excerpt }));

const blogMjc = (await getCollection('blog'))
  .filter((b) => b.data.project === 'mjc')
  .map((b) => ({ slug: b.slug, title: b.data.title, date: b.data.date, excerpt: b.data.excerpt }));

const actualites = [...newsMjc, ...blogMjc]
  .sort((a, b) => a.date.getTime() - b.date.getTime());

// Les dates annoncées sont partagées avec le calendrier général du site.
const today = new Date();
today.setHours(0, 0, 0, 0);
const prochainesDates = (await getCollection('events'))
  .filter((event) => event.data.spectacle.startsWith('Monsieur Jésus-Christ') && event.data.date >= today)
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime());

// Photos des premières : formats adaptés au web, sans agrandissement de la source.
const heroPortrait = await getImage({
  src: scenePortrait,
  format: 'webp',
  widths: [420, 640, 900, 1086],
  sizes: '(min-width: 900px) 40vw, 100vw',
  quality: 82,
});

// Repli JPEG pour les navigateurs sans WebP
const heroFallback = await getImage({ src: scenePortrait, format: 'jpeg', width: 1086, quality: 82 });
const photoPain = await getImage({ src: scenePain, format: 'webp', widths: [420, 640, 900, 1086], sizes: '(min-width: 700px) 45vw, 100vw', quality: 82 });
const photoBrasOuverts = await getImage({ src: sceneBrasOuverts, format: 'webp', widths: [420, 640, 941], sizes: '(min-width: 700px) 45vw, 100vw', quality: 82 });

// --- Le mot de Patrick Richard ---
// Pour publier cette partie : remplacer null par { texte: "…", signature: "Patrick Richard" }.
// Tant que la valeur est null, la section n'apparaît pas du tout sur la page publique.
const motDePatrick: { texte: string; signature: string } | null = null;

const imageAlt =
  "Steeve Gernez sur scène à Clermont-Ferrand, appuyé à la table auprès du pain, dans Monsieur Jésus-Christ";

// Œuvre théâtrale : les dates à venir seront annoncées une fois confirmées.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Play',
  name: 'Monsieur Jésus-Christ',
  alternativeHeadline: "Je voudrais vous parler d'un ami",
  description:
    "Du rire à la confidence, Steeve Gernez raconte Jésus comme un ami. Un seul en scène d'après le livre de Patrick Richard, mis en scène par Jacques Montembault. Découvrez le spectacle, invitez-le ou soutenez sa création.",
  url: 'https://allumeursdetoiles.com/mjc/',
  image: 'https://allumeursdetoiles.com/images/mjc/partage-clermont-20261020.jpg',
  inLanguage: 'fr',
  creativeWorkStatus: 'Spectacle créé, premières représentations en octobre 2026',
  genre: 'Théâtre',
  author: { '@type': 'Person', name: 'Steeve Gernez' },
  actor: { '@type': 'Person', name: 'Steeve Gernez' },
  director: { '@type': 'Person', name: 'Jacques Montembault' },
  isBasedOn: { '@type': 'Book', author: { '@type': 'Person', name: 'Patrick Richard' } },
  producer: {
    '@type': 'Organization',
    name: "Les Allumeurs d'Étoiles",
    url: 'https://allumeursdetoiles.com',
  },
};
---

<Layout
  title="Monsieur Jésus-Christ — Seul en scène"
  description="Du rire à la confidence, Steeve Gernez raconte Jésus comme un ami. Découvrez les premières images, invitez le spectacle ou soutenez sa création."
  ogTitle="Monsieur Jésus-Christ — Je voudrais vous parler d'un ami"
  ogDescription="Deux premières chaleureusement accueillies à Clermont-Ferrand. Une histoire d'amitié, d'humour et de rencontres à faire vivre près de chez vous."
  ogImage="/images/mjc/partage-clermont-20261020.jpg"
  ogImageAlt="Steeve Gernez dans Monsieur Jésus-Christ, à Clermont-Ferrand"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <div class="mjc">
    <!-- ================= 1. HERO ================= -->
    <section class="mjc-hero">
      <div class="mjc-hero-inner">
        <div class="mjc-hero-text">
          <p class="mjc-eyebrow reveal" style="--d: 0ms">Seul en scène avec Steeve Gernez</p>

          <h1 class="mjc-title reveal" style="--d: 90ms">
            <span class="mjc-title-top">Monsieur</span>
            <span class="mjc-title-main">Jésus-Christ</span>
          </h1>

          <div class="mjc-rule reveal" style="--d: 180ms" aria-hidden="true"></div>

          <p class="mjc-signature reveal" style="--d: 240ms">Je voudrais vous parler d'un ami.</p>

          <p class="mjc-status reveal" style="--d: 300ms">
            <span class="mjc-status-dot" aria-hidden="true"></span>
            L'aventure a rencontré son public
          </p>

          <p class="mjc-lead reveal" style="--d: 380ms">
            Du rire à la confidence, une histoire d'amitié à hauteur d'homme.
          </p>

          <p class="mjc-hero-intro">Un pain, une table, et Jésus raconté comme un ami. Un spectacle à partager, quelles que soient vos convictions.</p>

          <div class="mjc-hero-cta reveal" style="--d: 460ms">
            <a href="#accueillir" class="mjc-btn mjc-btn-primary">Inviter le spectacle</a>
            <a href="#soutenir" class="mjc-btn mjc-btn-ghost">Soutenir l'aventure</a>
          </div>
          <a href="#le-projet" class="mjc-hero-discover">Entrer dans l'histoire</a>
        </div>

        <div class="mjc-hero-media reveal" style="--d: 160ms">
          <picture>
            <source
              type="image/webp"
              srcset={heroPortrait.srcSet.attribute}
              sizes="(min-width: 900px) 40vw, 100vw"
            />
            <img
              src={heroFallback.src}
              alt={imageAlt}
              width="1086"
              height="1448"
              fetchpriority="high"
              decoding="async"
            />
          </picture>
        </div>
      </div>
    </section>

    <!-- ================= 2. PRÉSENTATION ================= -->
    <section class="mjc-section" id="le-projet">
      <div class="mjc-wrap">
        <h2 class="mjc-h2">Il vient vous parler d'un ami.</h2>

        <div class="mjc-columns">
          <div class="mjc-prose">
            <p class="mjc-prose-lead">
              Jésus. Cinq lettres, et déjà tout le monde a un avis.
            </p>
            <p>
              Steeve Gernez entre dans l'histoire avec un pain de campagne et l'envie de vous
              raconter quelqu'un. Jésus, comme on parle d'un ami : avec de l'affection, de
              l'étonnement, de l'humour et des questions qui ne nous lâchent pas.
            </p>
            <p>
              Une généalogie prend des allures de marathon. Une table dérange parce qu'on y
              accueille ceux qu'on ne fréquente pas. Le rire ouvre la porte à la confidence ;
              l'amitié se mesure à la peur, au doute et au désir de recommencer.
            </p>
            <p>Adapté du livre de Patrick Richard et mis en scène par Jacques Montembault, ce seul en scène s'adresse à ceux qui croient, à ceux qui doutent et aux curieux. Chacun y entre avec son histoire et en repart avec ses propres questions.</p>
          </div>

          <aside class="mjc-credits" aria-label="Informations sur le spectacle">
            <h3 class="mjc-credits-title">Le spectacle</h3>
            <dl>
              <div class="mjc-credit">
                <dt>Forme</dt>
                <dd>Seul en scène</dd>
              </div>
              <div class="mjc-credit">
                <dt>Texte et interprétation</dt>
                <dd>Steeve Gernez</dd>
              </div>
              <div class="mjc-credit">
                <dt>D'après le livre de</dt>
                <dd>Patrick Richard</dd>
              </div>
              <div class="mjc-credit">
                <dt>Mise en scène</dt>
                <dd>Jacques Montembault</dd>
              </div>
              <div class="mjc-credit">
                <dt>Production</dt>
                <dd>Les Allumeurs d'Étoiles</dd>
              </div>
            </dl>
            <p class="mjc-credits-note">Premières représentations à Clermont-Ferrand en octobre 2026.</p>
          </aside>
        </div>
      </div>
    </section>

    <!-- ================= 3. DU LIVRE À LA SCÈNE ================= -->
    <section class="mjc-section mjc-section-deep">
      <div class="mjc-wrap">
        <h2 class="mjc-h2">Du livre à la scène</h2>

        <figure class="mjc-quote">
          <blockquote>
            <p>
              Patrick m'a fait découvrir son livre et m'a offert ce texte. J'ai tout de suite eu envie
              de le faire entendre, de le partager avec mes moyens à moi : ceux d'un homme, d'un
              comédien et d'un ami. C'est comme ça que ses mots sont passés du livre à la scène.
            </p>
          </blockquote>
          <figcaption>Steeve Gernez</figcaption>
        </figure>

        {motDePatrick && (
          <figure class="mjc-quote mjc-quote-second">
            <blockquote>
              <p>{motDePatrick.texte}</p>
            </blockquote>
            <figcaption>{motDePatrick.signature}</figcaption>
          </figure>
        )}
      </div>
    </section>

    <!-- ================= 4. SUIVRE LA CRÉATION ================= -->
    <section class="mjc-section" id="suivre-la-creation">
      <div class="mjc-wrap">
        <h2 class="mjc-h2">Deux premières. Et l'envie de continuer.</h2>

        <p class="mjc-section-lead">
          En octobre 2026, Monsieur Jésus-Christ a rencontré son public au Festival de théâtre
          biblique de Clermont-Ferrand. Deux premières, un très bel accueil et déjà des demandes
          pour la suite. Merci à celles et ceux qui étaient là : cette histoire commence à voyager.
        </p>

        <div class="mjc-stage-photos">
          <figure>
            <img src={photoPain.src} srcset={photoPain.srcSet.attribute} sizes="(min-width: 700px) 45vw, 100vw" width="1086" height="1448" alt="Steeve Gernez assis, le pain entre les mains, dans un moment de confidence du spectacle" loading="lazy" decoding="async" />
            <figcaption>Un pain, une présence, une parole qui se partage.</figcaption>
          </figure>
          <figure>
            <img src={photoBrasOuverts.src} srcset={photoBrasOuverts.srcSet.attribute} sizes="(min-width: 700px) 45vw, 100vw" width="941" height="1672" alt="Steeve Gernez les bras ouverts face au public, auprès de la table et de la bougie" loading="lazy" decoding="async" />
            <figcaption>Seul sur scène. Avec le public, tout près.</figcaption>
          </figure>
        </div>
        <p class="mjc-photo-note">Clermont-Ferrand, octobre 2026.</p>

      </div>
    </section>

    <section class="mjc-section mjc-section-deep" id="les-etapes">
      <div class="mjc-wrap">
        <h2 class="mjc-h2">Une histoire qui avance</h2>
        <p class="mjc-section-lead">Du livre aux répétitions, des premières rencontres avec le public aux prochains rendez-vous : retrouvez les étapes de l'aventure.</p>
        {actualites.length > 0 && (
          <div class="mjc-actus">
            {actualites.map((a) => (
              <article class="mjc-actu">
                <p class="mjc-actu-date">
                  {a.date.toLocaleDateString('fr-FR', { year: 'numeric', month: 'long', day: 'numeric' })}
                </p>
                <h3 class="mjc-actu-title">
                  <a href={`/blog/${a.slug}`}>{a.title}</a>
                </h3>
                <p class="mjc-actu-excerpt">{a.excerpt}</p>
                <a href={`/blog/${a.slug}`} class="mjc-link">Lire la suite →</a>
              </article>
            ))}
          </div>
        )}
      </div>
    </section>

    <section class="mjc-section" id="prochaines-dates">
      <div class="mjc-wrap">
        <h2 class="mjc-h2">La suite se prépare près de chez vous</h2>
        <p class="mjc-section-lead">Après Clermont-Ferrand, de nouveaux rendez-vous se dessinent en décembre 2026.</p>
        <ul class="mjc-dates" aria-label="Prochaines représentations annoncées">
          {prochainesDates.map((event) => (
            <li>
              <time datetime={event.data.date.toISOString().slice(0, 10)}>{event.data.date.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })}</time>
              <span>{event.data.ville}{event.data.spectacle.includes('scolaire') && ' — représentation scolaire'}</span>
            </li>
          ))}
        </ul>
        <p class="mjc-pending-date"><strong>Également en préparation : Chambéry, les 8 et 9 décembre 2026.</strong> Ces deux dates restent à confirmer.</p>
        <p class="mjc-dates-note">Les lieux, horaires et modalités d'accueil seront précisés à mesure de leur confirmation.</p>
        <a href="/tournee" class="mjc-link">Voir le calendrier des spectacles</a>
      </div>
    </section>

    <!-- ================= 5. ACCUEILLIR ET SOUTENIR ================= -->
    <section class="mjc-section mjc-invitation-section" id="accueillir">
      <div class="mjc-wrap mjc-invitation">
        <div>
          <h2 class="mjc-h2">Et si cette rencontre avait lieu chez vous ?</h2>
          <p class="mjc-section-lead">Un théâtre, une association, une paroisse, un festival : votre lieu peut devenir la prochaine étape de l'aventure.</p>
        </div>
        <div class="mjc-prose">
          <p>Vous avez envie de proposer un spectacle qui fait sourire, questionne et ouvre la conversation ? Parlons de votre public, de votre lieu et des dates que vous imaginez.</p>
          <p>L'équipe d'Allumeurs d'étoiles vous transmettra le dossier de présentation et les éléments techniques pour préparer ensemble l'accueil du spectacle.</p>
          <a href="/contact?sujet=programmation-mjc" class="mjc-btn mjc-btn-primary">Parlons d'une représentation</a>
          <p class="mjc-direct-contact">Ou écrivez à <a href="mailto:contact@allumeursdetoiles.com?subject=Monsieur%20J%C3%A9sus-Christ%20%E2%80%94%20accueillir%20le%20spectacle">contact@allumeursdetoiles.com</a></p>
        </div>
      </div>
    </section>

    <section class="mjc-section mjc-support-section" id="soutenir">
      <div class="mjc-wrap mjc-support">
        <div>
          <h2 class="mjc-h2">Nous l'avons fait naître.<br />Aidons-le à poursuivre sa route.</h2>
          <p class="mjc-section-lead">Sur scène, un homme. Autour de lui, une histoire d'amitié et toutes les personnes qui rendent cette aventure possible.</p>
        </div>
        <div class="mjc-prose">
          <p>Parce qu'elle croit à ce spectacle, Allumeurs d'étoiles a avancé une partie des frais de création : répétitions, déplacements, mise en scène, décor et communication.</p>
          <p>Les premières ont eu lieu. Le financement de la création reste à compléter. La collecte vise à réunir <strong>5 000 €</strong> pour contribuer aux dépenses déjà engagées et à venir, et aborder plus sereinement la suite.</p>
          <p>Un don, du montant qui vous convient, nous aide à faire vivre ce spectacle et à le porter vers d'autres publics. Merci aux premiers donateurs et à toutes celles et ceux qui font circuler cette histoire.</p>
          <a href={fundraiserUrl} class="mjc-btn mjc-btn-primary" target="_blank" rel="noopener noreferrer">Je soutiens sur HelloAsso<span class="sr-only"> (nouvel onglet)</span></a>
          <p class="mjc-support-note">Don libre à partir de 1 €. Les dons sont reçus par Allumeurs d'étoiles. Retrouvez l'avancement actualisé et le détail du projet sur HelloAsso.</p>
        </div>
      </div>
    </section>

    <!-- ================= 6. GARDER LE LIEN ================= -->
    <section class="mjc-section mjc-section-deep">
      <div class="mjc-wrap">
        <div class="mjc-paths">
          <article class="mjc-path">
            <h2 class="mjc-path-title">Recevoir des nouvelles</h2>
            <p>
              Prochaines représentations, nouvelles images, étapes de l'aventure : gardons le lien.
            </p>

            <!--
              Formulaire Netlify Forms : même dispositif que le formulaire de contact
              (honeypot « bot-field »). Envoi en arrière-plan quand JavaScript est actif,
              sinon repli classique vers la page de confirmation.
            -->
            <form
              class="mjc-form"
              id="mjc-form"
              name="suivi-mjc"
              method="POST"
              action="/contact-confirme"
              data-netlify="true"
              netlify-honeypot="bot-field"
            >
              <input type="hidden" name="form-name" value="suivi-mjc" />
              <input type="hidden" name="projet" value="Monsieur Jésus-Christ" />
              <p class="mjc-hp">
                <label>Ne pas remplir : <input name="bot-field" tabindex="-1" /></label>
              </p>

              <div class="mjc-field">
                <label for="mjc-email">Votre adresse email</label>
                <input
                  type="email"
                  id="mjc-email"
                  name="email"
                  required
                  autocomplete="email"
                  placeholder="vous@exemple.fr"
                />
              </div>

              <div class="mjc-consent">
                <input type="checkbox" id="mjc-consent" name="consentement" value="oui" required />
                <label for="mjc-consent">
                  J'accepte de recevoir des nouvelles de « Monsieur Jésus-Christ ».
                  Mon adresse ne servira qu'à cela et je peux me désinscrire à tout moment.
                </label>
              </div>

              <button type="submit" class="mjc-btn mjc-btn-primary">Recevoir les nouvelles</button>

              <p class="mjc-form-message" id="mjc-form-message" role="status" aria-live="polite"></p>

              <p class="mjc-form-legal">
                Votre adresse sert uniquement à ce suivi.
                <a href="/politique-confidentialite">Politique de confidentialité</a>
              </p>
            </form>
          </article>

          <article class="mjc-path mjc-path-pro">
            <h2 class="mjc-path-title">Une histoire à faire circuler</h2>
            <p>
              Vous pensez à un lieu, à une équipe, à quelqu'un que ce spectacle pourrait toucher ?
              Transmettez-lui cette page. Les rencontres commencent souvent ainsi.
            </p>
            <a href="#le-projet" class="mjc-btn mjc-btn-ghost">
              Revenir au spectacle
            </a>
          </article>
        </div>
      </div>
    </section>

    <!-- ================= 6. PARTAGE ================= -->
    <section class="mjc-share-section">
      <div class="mjc-wrap">
        <div class="mjc-share">
          <p class="mjc-share-text">Cette histoire vous parle ? Faites-la découvrir.</p>
          <div class="mjc-share-actions">
            <button type="button" class="mjc-btn mjc-btn-ghost" id="mjc-share-native" hidden>
              Partager
            </button>
            <button type="button" class="mjc-btn mjc-btn-ghost" id="mjc-share-copy">
              Copier le lien
            </button>
            <span class="mjc-share-feedback" id="mjc-share-feedback" role="status" aria-live="polite"
            ></span>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  /* ============================================================
     Univers visuel « Monsieur Jésus-Christ »
     Palette relevée sur l'affiche : crème papier, anthracite, terre cuite.
     Variables volontairement limitées à cette page (.mjc) pour ne rien
     changer au reste du site.
     ============================================================ */
  .mjc {
    --mjc-cream: #f7f0e2;
    --mjc-cream-deep: #f0e5cf;
    --mjc-paper: #fbf7ee;
    --mjc-ink: #24313a;
    --mjc-ink-soft: #4e5b63;
    --mjc-terracotta: #9e4e32;
    --mjc-terracotta-bright: #b85c39;
    --mjc-line: rgba(36, 49, 58, 0.14);

    background-color: var(--mjc-cream);
    color: var(--mjc-ink);
  }

  /* Compense le header collant lors des sauts d'ancre */
  .mjc [id] {
    scroll-margin-top: 6.5rem;
  }

  .mjc-wrap {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 var(--spacing-md);
  }

  /* ---------- Animation d'arrivée (désactivée si mouvement réduit) ---------- */
  .reveal {
    animation: mjc-rise 0.7s cubic-bezier(0.22, 0.61, 0.36, 1) both;
    animation-delay: var(--d, 0ms);
  }

  @keyframes mjc-rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal {
      animation: none;
    }
  }

  /* ============================ 1. HERO ============================ */
  .mjc-hero {
    background-color: var(--mjc-cream);
    padding: clamp(2rem, 5vw, 4rem) 0 clamp(3rem, 6vw, 5rem);
    position: relative;
    overflow: hidden;
  }

  /* Halo chaud très discret, rappel de la lumière rasante de l'affiche */
  .mjc-hero::before {
    content: '';
    position: absolute;
    inset: auto auto -30% -20%;
    width: 60vw;
    height: 60vw;
    max-width: 700px;
    max-height: 700px;
    background: radial-gradient(circle, rgba(158, 78, 50, 0.07) 0%, transparent 70%);
    pointer-events: none;
  }

  .mjc-hero-inner {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 var(--spacing-md);
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
    position: relative;
  }

  .mjc-eyebrow {
    margin: 0 0 1.25rem;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--mjc-terracotta);
  }

  /* Titre en vrai texte HTML (accessibilité, responsive, référencement) */
  .mjc-title {
    margin: 0;
    color: var(--mjc-ink);
    font-family: var(--font-heading);
    font-style: normal;
    line-height: 0.92;
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }

  .mjc-title-top {
    display: block;
    font-size: clamp(1.75rem, 4.2vw, 2.9rem);
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .mjc-title-main {
    display: block;
    font-size: clamp(2.55rem, 6.4vw, 5rem);
    font-weight: 900;
    margin-top: 0.1em;
  }

  .mjc-rule {
    width: 84px;
    height: 5px;
    margin: 1.6rem 0 1.4rem;
    background-color: var(--mjc-terracotta);
    border-radius: 3px;
  }

  .mjc-signature {
    margin: 0 0 1.6rem;
    font-size: clamp(1.05rem, 2.2vw, 1.35rem);
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--mjc-ink);
  }

