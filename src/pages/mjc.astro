<script>
  // Partage : API native sur mobile, copie du lien partout ailleurs.
  document.addEventListener('DOMContentLoaded', () => {
    const nativeBtn = document.getElementById('mjc-share-native');
    const copyBtn = document.getElementById('mjc-share-copy');
    const feedback = document.getElementById('mjc-share-feedback');

    // Lien partagé toujours propre : sans les paramètres de campagne du QR code
    const shareUrl = window.location.origin + window.location.pathname;
    const shareData = {
      title: 'Monsieur Jésus-Christ — Le livre monte sur scène',
      text: "Découvrez la création du nouveau seul-en-scène de Steeve Gernez, d'après le livre de Patrick Richard.",
      url: shareUrl,
    };

    const say = (message: string) => {
      if (!feedback) return;
      feedback.textContent = message;
      window.setTimeout(() => {
        feedback.textContent = '';
      }, 3000);
    };

    if (nativeBtn && typeof navigator.share === 'function') {
      nativeBtn.hidden = false;
      nativeBtn.addEventListener('click', async () => {
        try {
          await navigator.share(shareData);
        } catch {
          // Partage annulé par la personne : rien à signaler
        }
      });
    }

    // --- Inscription au suivi de la création (Netlify Forms) ---
    const form = document.getElementById('mjc-form');
    const formMessage = document.getElementById('mjc-form-message');

    form?.addEventListener('submit', async (event) => {
      if (!(form instanceof HTMLFormElement)) return;
      // Sans JavaScript, le navigateur poste le formulaire normalement (repli natif)
      event.preventDefault();

      const bouton = form.querySelector('button[type="submit"]');
      const libelle = bouton?.textContent;
      if (bouton instanceof HTMLButtonElement) {
        bouton.disabled = true;
        bouton.textContent = 'Envoi…';
      }
      if (formMessage) formMessage.textContent = '';

      try {
        const reponse = await fetch('/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams(new FormData(form)).toString(),
        });
        if (!reponse.ok) throw new Error('Envoi refusé');

        // Remplace le formulaire par la confirmation
        const confirmation = document.createElement('div');
        confirmation.className = 'mjc-form-done';
        confirmation.setAttribute('role', 'status');
        confirmation.innerHTML =
          '<p><strong>C\'est noté, merci !</strong> ' +
          'Votre inscription aux nouvelles de la création de « Monsieur Jésus-Christ » ' +
          'a bien été enregistrée.</p>';
        form.replaceWith(confirmation);
      } catch {
        if (bouton instanceof HTMLButtonElement) {
          bouton.disabled = false;
          if (libelle) bouton.textContent = libelle;
        }
        if (formMessage) {
          formMessage.textContent =
            "L'inscription n'a pas pu aboutir. Réessayez dans un instant ou écrivez-nous à contact@allumeursdetoiles.com.";
        }
      }
    });

    copyBtn?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(shareUrl);
        say('Lien copié');
      } catch {
        say(shareUrl);
      }
    });
  });
</script>
