---
import Layout from '../layouts/Layout.astro';
import { getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import scenePortrait from '../assets/mjc/scene-portrait.jpg';
import scenePaysage from '../assets/mjc/scene-paysage.jpg';

// --- Actualités rattachées au projet (champ "project: mjc" dans le CMS) ---
// Tant qu'aucune actualité n'est rattachée, la section affiche un état "À suivre".
const newsMjc = (await getCollection('news'))
  .filter((n) => n.data.project === 'mjc')
  .map((n) => ({ slug: n.slug, title: n.data.title, date: n.data.date, excerpt: n.data.excerpt }));

const blogMjc = (await getCollection('blog'))
  .filter((b) => b.data.project === 'mjc')
  .map((b) => ({ slug: b.slug, title: b.data.title, date: b.data.date, excerpt: b.data.excerpt }));

const actualites = [...newsMjc, ...blogMjc]
  .sort((a, b) => b.date.getTime() - a.date.getTime())
  .slice(0, 3);

// --- Cadrages dérivés de l'affiche (sans la typographie de l'affiche) ---
// Portrait 4:5 pour les grands écrans, paysage 3:2 pour mobile et tablette.
const heroPortrait = await getImage({
  src: scenePortrait,
  format: 'webp',
  widths: [420, 640, 900, 1200],
  sizes: '(min-width: 1200px) 30vw, 40vw',
  quality: 82,
});

const heroPaysage = await getImage({
  src: scenePaysage,
  format: 'webp',
  widths: [640, 960, 1280, 1600],
  sizes: '100vw',
  quality: 80,
});

// Repli JPEG pour les navigateurs sans WebP
const heroFallback = await getImage({ src: scenePaysage, format: 'jpeg', width: 1100, quality: 82 });

// --- Le mot de Patrick Richard ---
// Pour publier cette partie : remplacer null par { texte: "…", signature: "Patrick Richard" }.
// Tant que la valeur est null, la section n'apparaît pas du tout sur la page publique.
const motDePatrick: { texte: string; signature: string } | null = null;

const imageAlt =
  "Une chaise de théâtre en bois, vide, derrière une table où repose un pain rompu, dans une lumière rasante";

// --- Données structurées : œuvre théâtrale, sans aucune date (le spectacle est en création) ---
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Play',
  name: 'Monsieur Jésus-Christ',
  alternativeHeadline: 'Le livre monte sur scène',
  description:
    "Seul-en-scène de Steeve Gernez, mis en scène par Jacques Montembault, d'après le livre de Patrick Richard. Spectacle actuellement en création.",
  url: 'https://allumeursdetoiles.com/mjc/',
  image: 'https://allumeursdetoiles.com/images/mjc/partage-mjc.jpg',
  inLanguage: 'fr',
  creativeWorkStatus: 'En création',
  genre: 'Théâtre',
  author: { '@type': 'Person', name: 'Steeve Gernez' },
  actor: { '@type': 'Person', name: 'Steeve Gernez' },
  director: { '@type': 'Person', name: 'Jacques Montembault' },
  isBasedOn: { '@type': 'Book', author: { '@type': 'Person', name: 'Patrick Richard' } },
  producer: {
    '@type': 'Organization',
    name: "Les Allumeurs d'Étoiles",
    url: 'https://allumeursdetoiles.com',
  },
};
---

<Layout
  title="Monsieur Jésus-Christ — Seul en scène"
  description="Découvrez Monsieur Jésus-Christ, le nouveau seul-en-scène de Steeve Gernez, mis en scène par Jacques Montembault et inspiré du livre de Patrick Richard."
  ogTitle="Monsieur Jésus-Christ — Le livre monte sur scène"
  ogDescription="Découvrez la création du nouveau seul-en-scène de Steeve Gernez, d'après le livre de Patrick Richard."
  ogImage="/images/mjc/partage-mjc.jpg"
  ogImageAlt="Monsieur Jésus-Christ — Le livre monte sur scène"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <div class="mjc">
    <!-- ================= 1. HERO ================= -->
    <section class="mjc-hero">
      <div class="mjc-hero-inner">
        <div class="mjc-hero-text">
          <p class="mjc-eyebrow reveal" style="--d: 0ms">Seul en scène</p>

          <h1 class="mjc-title reveal" style="--d: 90ms">
            <span class="mjc-title-top">Monsieur</span>
            <span class="mjc-title-main">Jésus-Christ</span>
          </h1>

          <div class="mjc-rule reveal" style="--d: 180ms" aria-hidden="true"></div>

          <p class="mjc-signature reveal" style="--d: 240ms">Le livre monte sur scène</p>

          <p class="mjc-status reveal" style="--d: 300ms">
            <span class="mjc-status-dot" aria-hidden="true"></span>
            Spectacle en création
          </p>

          <p class="mjc-lead reveal" style="--d: 380ms">
            « Qui est Jésus lorsqu'on le regarde d'abord comme un homme ? »
          </p>

          <div class="mjc-hero-cta reveal" style="--d: 460ms">
            <a href="#le-projet" class="mjc-btn mjc-btn-primary">Découvrir le projet</a>
            <a href="#suivre-la-creation" class="mjc-btn mjc-btn-ghost">Suivre la création</a>
          </div>
        </div>

        <div class="mjc-hero-media reveal" style="--d: 160ms">
          <picture>
            <source
              media="(min-width: 900px)"
              type="image/webp"
              srcset={heroPortrait.srcSet.attribute}
              sizes="(min-width: 1200px) 30vw, 40vw"
              width="1200"
              height="1484"
            />
            <source
              type="image/webp"
              srcset={heroPaysage.srcSet.attribute}
              sizes="100vw"
              width="1600"
              height="1066"
            />
            <img
              src={heroFallback.src}
              alt={imageAlt}
              width="1600"
              height="1066"
              fetchpriority="high"
              decoding="async"
            />
          </picture>
        </div>
      </div>
    </section>

    <!-- ================= 2. PRÉSENTATION ================= -->
    <section class="mjc-section" id="le-projet">
      <div class="mjc-wrap">
        <h2 class="mjc-h2">Un homme avant une figure</h2>

        <div class="mjc-columns">
          <div class="mjc-prose">
            <p class="mjc-prose-lead">
              Qui est Jésus lorsqu'on le regarde d'abord comme un homme ?
            </p>
            <p>
              Dans ce seul-en-scène, Steeve Gernez donne corps et voix à un Jésus proche, vivant et
              profondément humain. Un homme qui doute, qui questionne, qui partage et qui nous invite
              à regarder autrement ce qui nous relie.
            </p>
            <p>
              Un spectacle à la croisée du théâtre, de la parole et de la rencontre.
            </p>
          </div>

          <aside class="mjc-credits" aria-label="Informations sur le spectacle">
            <h3 class="mjc-credits-title">Le spectacle</h3>
            <dl>
              <div class="mjc-credit">
                <dt>Forme</dt>
                <dd>Seul en scène</dd>
              </div>
              <div class="mjc-credit">
                <dt>Texte et interprétation</dt>
                <dd>Steeve Gernez</dd>
              </div>
              <div class="mjc-credit">
                <dt>Mise en scène</dt>
                <dd>Jacques Montembault</dd>
              </div>
              <div class="mjc-credit">
                <dt>D'après le livre de</dt>
                <dd>Patrick Richard</dd>
              </div>
              <div class="mjc-credit">
                <dt>Production</dt>
                <dd>Les Allumeurs d'Étoiles</dd>
              </div>
            </dl>
            <p class="mjc-credits-note">Spectacle actuellement en création.</p>
          </aside>
        </div>
      </div>
    </section>

    <!-- ================= 3. DU LIVRE À LA SCÈNE ================= -->
    <section class="mjc-section mjc-section-deep">
      <div class="mjc-wrap">
        <h2 class="mjc-h2">Du livre à la scène</h2>

        <figure class="mjc-quote">
          <blockquote>
            <p>
              Patrick m'a fait découvrir son livre et m'a offert ce texte. J'ai tout de suite eu envie
              de le faire entendre, de le partager avec mes moyens à moi : ceux d'un homme, d'un
              comédien et d'un ami. C'est comme ça que ses mots sont passés du livre à la scène.
            </p>
          </blockquote>
          <figcaption>Steeve Gernez</figcaption>
        </figure>

        {motDePatrick && (
          <figure class="mjc-quote mjc-quote-second">
            <blockquote>
              <p>{motDePatrick.texte}</p>
            </blockquote>
            <figcaption>{motDePatrick.signature}</figcaption>
          </figure>
        )}
      </div>
    </section>

    <!-- ================= 4. SUIVRE LA CRÉATION ================= -->
    <section class="mjc-section" id="suivre-la-creation">
      <div class="mjc-wrap">
        <h2 class="mjc-h2">Le spectacle se construit</h2>

        <p class="mjc-section-lead">
          Les répétitions ont commencé. Le texte prend corps, la mise en scène se précise et
          l'aventure ne fait que commencer. Nous partagerons ici les premières images, les étapes de
          travail et les dates à venir.
        </p>

        {actualites.length > 0 ? (
          <div class="mjc-actus">
            {actualites.map((a) => (
              <article class="mjc-actu">
                <p class="mjc-actu-date">
                  {a.date.toLocaleDateString('fr-FR', { year: 'numeric', month: 'long', day: 'numeric' })}
                </p>
                <h3 class="mjc-actu-title">
                  <a href={`/blog/${a.slug}`}>{a.title}</a>
                </h3>
                <p class="mjc-actu-excerpt">{a.excerpt}</p>
                <a href={`/blog/${a.slug}`} class="mjc-link">Lire la suite →</a>
              </article>
            ))}
          </div>
        ) : (
          <div class="mjc-soon">
            <p class="mjc-soon-label">À suivre</p>
            <p class="mjc-soon-text">
              Les premières nouvelles de la création seront publiées ici au fil des répétitions.
            </p>
            <ul class="mjc-soon-list">
              <li>Étapes de travail</li>
              <li>Premières images</li>
              <li>Paroles de l'équipe</li>
              <li>Teaser</li>
              <li>Premières dates</li>
            </ul>
          </div>
        )}
      </div>
    </section>

    <!-- ================= 5. DEUX PARCOURS ================= -->
    <section class="mjc-section mjc-section-deep">
      <div class="mjc-wrap">
        <div class="mjc-paths">
          <article class="mjc-path">
            <p class="mjc-path-tag">Public</p>
            <h2 class="mjc-path-title">Suivre l'aventure</h2>
            <p>
              Premières images, étapes de création et prochaines représentations : restez au courant
              de la suite.
            </p>

            <!--
              Formulaire Netlify Forms : même dispositif que le formulaire de contact
              (honeypot « bot-field »). Envoi en arrière-plan quand JavaScript est actif,
              sinon repli classique vers la page de confirmation.
            -->
            <form
              class="mjc-form"
              id="mjc-form"
              name="suivi-mjc"
              method="POST"
              action="/contact-confirme"
              data-netlify="true"
              netlify-honeypot="bot-field"
            >
              <input type="hidden" name="form-name" value="suivi-mjc" />
              <input type="hidden" name="projet" value="Monsieur Jésus-Christ" />
              <p class="mjc-hp">
                <label>Ne pas remplir : <input name="bot-field" tabindex="-1" /></label>
              </p>

              <div class="mjc-field">
                <label for="mjc-email">Votre adresse email</label>
                <input
                  type="email"
                  id="mjc-email"
                  name="email"
                  required
                  autocomplete="email"
                  placeholder="vous@exemple.fr"
                />
              </div>

              <div class="mjc-consent">
                <input type="checkbox" id="mjc-consent" name="consentement" value="oui" required />
                <label for="mjc-consent">
                  J'accepte de recevoir des nouvelles de la création de « Monsieur Jésus-Christ ».
                  Mon adresse ne servira qu'à cela et je peux me désinscrire à tout moment.
                </label>
              </div>

              <button type="submit" class="mjc-btn mjc-btn-primary">Suivre la création</button>

              <p class="mjc-form-message" id="mjc-form-message" role="status" aria-live="polite"></p>

              <p class="mjc-form-legal">
                Votre adresse sert uniquement à ce suivi.
                <a href="/politique-confidentialite">Politique de confidentialité</a>
              </p>
            </form>
          </article>

          <article class="mjc-path mjc-path-pro">
            <p class="mjc-path-tag">Professionnels</p>
            <h2 class="mjc-path-title">Accueillir le spectacle</h2>
            <p>
              Vous représentez un théâtre, un lieu culturel, une association, une paroisse ou un
              festival ? Échangeons dès maintenant autour du projet.
            </p>
            <a href="/contact?sujet=programmation-mjc" class="mjc-btn mjc-btn-primary">
              Parler du spectacle
            </a>
          </article>
        </div>
      </div>
    </section>

    <!-- ================= 6. PARTAGE ================= -->
    <section class="mjc-share-section">
      <div class="mjc-wrap">
        <div class="mjc-share">
          <p class="mjc-share-text">Ce projet vous parle ? Faites-le découvrir.</p>
          <div class="mjc-share-actions">
            <button type="button" class="mjc-btn mjc-btn-ghost" id="mjc-share-native" hidden>
              Partager
            </button>
            <button type="button" class="mjc-btn mjc-btn-ghost" id="mjc-share-copy">
              Copier le lien
            </button>
            <span class="mjc-share-feedback" id="mjc-share-feedback" role="status" aria-live="polite"
            ></span>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  /* ============================================================
     Univers visuel « Monsieur Jésus-Christ »
     Palette relevée sur l'affiche : crème papier, anthracite, terre cuite.
     Variables volontairement limitées à cette page (.mjc) pour ne rien
     changer au reste du site.
     ============================================================ */
  .mjc {
    --mjc-cream: #f7f0e2;
    --mjc-cream-deep: #f0e5cf;
    --mjc-paper: #fbf7ee;
    --mjc-ink: #24313a;
    --mjc-ink-soft: #4e5b63;
    --mjc-terracotta: #9e4e32;
    --mjc-terracotta-bright: #b85c39;
    --mjc-line: rgba(36, 49, 58, 0.14);

    background-color: var(--mjc-cream);
    color: var(--mjc-ink);
  }

  /* Compense le header collant lors des sauts d'ancre */
  .mjc [id] {
    scroll-margin-top: 6.5rem;
  }

  .mjc-wrap {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 var(--spacing-md);
  }

  /* ---------- Animation d'arrivée (désactivée si mouvement réduit) ---------- */
  .reveal {
    animation: mjc-rise 0.7s cubic-bezier(0.22, 0.61, 0.36, 1) both;
    animation-delay: var(--d, 0ms);
  }

  @keyframes mjc-rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal {
      animation: none;
    }
  }

  /* ============================ 1. HERO ============================ */
  .mjc-hero {
    background-color: var(--mjc-cream);
    padding: clamp(3rem, 7vw, 6rem) 0 clamp(3rem, 6vw, 5rem);
    position: relative;
    overflow: hidden;
  }

  /* Halo chaud très discret, rappel de la lumière rasante de l'affiche */
  .mjc-hero::before {
    content: '';
    position: absolute;
    inset: auto auto -30% -20%;
    width: 60vw;
    height: 60vw;
    max-width: 700px;
    max-height: 700px;
    background: radial-gradient(circle, rgba(158, 78, 50, 0.07) 0%, transparent 70%);
    pointer-events: none;
  }

  .mjc-hero-inner {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 var(--spacing-md);
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
    position: relative;
  }

  .mjc-eyebrow {
    margin: 0 0 1.25rem;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--mjc-terracotta);
  }

  /* Titre en vrai texte HTML (accessibilité, responsive, référencement) */
  .mjc-title {
    margin: 0;
    color: var(--mjc-ink);
    font-family: var(--font-heading);
    font-style: normal;
    line-height: 0.92;
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }

  .mjc-title-top {
    display: block;
    font-size: clamp(1.75rem, 4.2vw, 2.9rem);
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .mjc-title-main {
    display: block;
    font-size: clamp(2.55rem, 6.4vw, 5rem);
    font-weight: 900;
    margin-top: 0.1em;
  }

  .mjc-rule {
    width: 84px;
    height: 5px;
    margin: 1.6rem 0 1.4rem;
    background-color: var(--mjc-terracotta);
    border-radius: 3px;
  }

  .mjc-signature {
    margin: 0 0 1.6rem;
    font-size: clamp(1.05rem, 2.2vw, 1.35rem);
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--mjc-ink);
  }

  .mjc-status {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0 0 2rem;
    padding: 0.45rem 1.1rem;
    border: 1px solid rgba(158, 78, 50, 0.4);
    border-radius: 999px;
    background-color: rgba(158, 78, 50, 0.06);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--mjc-terracotta);
  }

  .mjc-status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background-color: var(--mjc-terracotta);
    flex-shrink: 0;
  }

  .mjc-lead {
    max-width: 30ch;
    margin: 0 0 2.4rem;
    font-family: var(--font-heading);
    font-size: clamp(1.3rem, 2.9vw, 1.9rem);
    font-style: italic;
    font-weight: 400;
    line-height: 1.35;
    color: var(--mjc-ink-soft);
  }

  .mjc-hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .mjc-hero-media picture,
  .mjc-hero-media img {
    display: block;
    width: 100%;
  }

  .mjc-hero-media img {
    aspect-ratio: 1600 / 1066;
    object-fit: cover;
    border-radius: 2px;
    box-shadow: 0 18px 50px rgba(36, 49, 58, 0.18);
  }

  /* ---------- Boutons propres à la page ---------- */
  .mjc-btn {
    display: inline-block;
    padding: 0.95rem 2.1rem;
    border: 1px solid transparent;
    border-radius: 2px;
    font-family: var(--font-body);
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-align: center;
    cursor: pointer;
    transition:
      background-color 0.25s ease,
      color 0.25s ease,
      border-color 0.25s ease,
      transform 0.25s ease;
  }

  .mjc-btn-primary {
    background-color: var(--mjc-terracotta);
    color: #fff;
  }

  .mjc-btn-primary:hover {
    background-color: var(--mjc-terracotta-bright);
    color: #fff;
    transform: translateY(-2px);
  }

  .mjc-btn-ghost {
    background-color: transparent;
    border-color: rgba(36, 49, 58, 0.35);
    color: var(--mjc-ink);
  }

  .mjc-btn-ghost:hover {
    background-color: var(--mjc-ink);
    border-color: var(--mjc-ink);
    color: var(--mjc-cream);
    transform: translateY(-2px);
  }

  .mjc-btn:focus-visible {
    outline: 3px solid var(--mjc-terracotta);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .mjc-btn:hover {
      transform: none;
    }
  }

  /* ============================ Sections ============================ */
  .mjc-section {
    padding: clamp(3.5rem, 8vw, 6.5rem) 0;
  }

  .mjc-section-deep {
    background-color: var(--mjc-cream-deep);
  }

  .mjc-h2 {
    margin: 0 0 2.5rem;
    color: var(--mjc-ink);
    font-family: var(--font-heading);
    font-size: clamp(1.8rem, 4.4vw, 3rem);
    font-weight: 800;
    font-style: normal;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    line-height: 1.05;
  }

  .mjc-h2::after {
    content: '';
    display: block;
    width: 60px;
    height: 4px;
    margin-top: 1.1rem;
    background-color: var(--mjc-terracotta);
    border-radius: 2px;
  }

  .mjc-section-lead {
    max-width: 62ch;
    margin: 0 0 2.5rem;
    font-size: 1.15rem;
    line-height: 1.75;
    color: var(--mjc-ink-soft);
  }

  /* ---------- 2. Présentation ---------- */
  .mjc-columns {
    display: grid;
    gap: clamp(2rem, 5vw, 3.5rem);
    align-items: start;
  }

  .mjc-prose p {
    margin: 0 0 1.4rem;
    font-size: 1.1rem;
    line-height: 1.8;
    color: var(--mjc-ink-soft);
  }

  .mjc-prose-lead {
    font-family: var(--font-heading);
    font-size: 1.4rem !important;
    font-style: italic;
    line-height: 1.5 !important;
    color: var(--mjc-ink) !important;
  }

  .mjc-credits {
    padding: clamp(1.75rem, 4vw, 2.5rem);
    background-color: var(--mjc-paper);
    border: 1px solid var(--mjc-line);
    border-top: 4px solid var(--mjc-terracotta);
  }

  .mjc-credits-title {
    margin: 0 0 1.5rem;
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--mjc-terracotta);
  }

  .mjc-credits dl {
    margin: 0;
  }

  .mjc-credit {
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--mjc-line);
  }

  .mjc-credit:last-of-type {
    border-bottom: none;
  }

  .mjc-credit dt {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--mjc-ink-soft);
  }

  .mjc-credit dd {
    margin: 0.25rem 0 0;
    font-size: 1.05rem;
    font-weight: 500;
